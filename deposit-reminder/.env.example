# Provider settings for deposit-reminder. Placeholders only: never commit real values.
# Locally, copy this to .dev.vars, then uncomment a provider and fill in its keys.
# Anything left commented out stays local: `actuate dev` prints messages and fakes payments.
# On the hosted platform, set providers in the dashboard (Settings → Providers) instead.
# Every provider and its variables: npx actuate providers

# messaging: telegram (or whatsapp, slack, discord, resend, custom-webhook)
# ACTUATE_MESSAGING=telegram
# TELEGRAM_BOT_TOKEN=

# payment: billplz (or stripe, toyyibpay, chip)
# ACTUATE_PAYMENT=billplz
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_X_SIGNATURE_KEY=

# Runtime (self-hosted or `actuate dev` only)
# ACTUATE_WEBHOOK_SECRET=
