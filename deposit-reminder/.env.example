# Provider credentials for deposit-reminder. Placeholders only: never commit real values.
# `actuate dev` prints messages and fakes payment links, so you need none of these locally.
# In production, enter them in the Actuate dashboard when you configure each provider.

# messaging: Telegram (default channel)
TELEGRAM_BOT_TOKEN=
# ...or WhatsApp Cloud API, from your own Meta app
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# payment: pick one of Stripe, Chip, ToyyibPay or Billplz
CHIP_API_KEY=
CHIP_BRAND_ID=
# STRIPE_SECRET_KEY=
# TOYYIBPAY_SECRET_KEY=
# BILLPLZ_API_KEY=

# Runtime (self-hosted or `actuate dev` only)
ACTUATE_WEBHOOK_SECRET=
